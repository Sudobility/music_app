{
  "name": "scoresmith",
  "version": "0.2.194",
  "description": "ScoreSmith - a browser-based AI-assisted sheet-music composition app",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:cf-env": "curl -sL https://raw.githubusercontent.com/johnqh/workflows/main/scripts/generate-cloudflare-env.ts -o /tmp/generate-cloudflare-env.ts && bunx tsx /tmp/generate-cloudflare-env.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "icons": "bash scripts/make-icons.sh",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "localize": "SCRIPT=$(mktemp) && curl -fsSL https://raw.githubusercontent.com/johnqh/workflows/main/scripts/localize_batch.cjs -o $SCRIPT && WHISPERLY_API_KEY=$(grep -h '^WHISPERLY_API_KEY=' ~/.develop/.keys ~/.keys ~/.keys.txt 2>/dev/null | head -1 | cut -d= -f2-) node $SCRIPT ./public/locales https://api.whisperly.dev/api/v1/translate/jie9cytr/moosiac && rm -f $SCRIPT && prettier . --write",
    "localize_local": "SCRIPT=$(mktemp) && curl -fsSL https://raw.githubusercontent.com/johnqh/workflows/main/scripts/localize_batch.cjs -o $SCRIPT && node $SCRIPT ./public/locales http://localhost:8021/api/v1/translate/jie9cytr/moosiac && rm -f $SCRIPT && prettier . --write",
    "localized": "node scripts/localization_verify.cjs",
    "verify": "bun run typecheck && bun run lint && bun run test:unit && bun run build",
    "process:static": "curl -sL https://raw.githubusercontent.com/johnqh/workflows/main/scripts/process-static-files.ts -o /tmp/process-static-files.ts && bunx tsx /tmp/process-static-files.ts",
    "seo:fetch": "curl -fsSL https://raw.githubusercontent.com/johnqh/workflows/main/scripts/generate-seo-assets-v2.mjs -o /tmp/generate-seo-assets.mjs",
    "generate:sitemap": "bun run seo:fetch && node /tmp/generate-seo-assets.mjs public",
    "prerender": "node scripts/prerender.mjs",
    "prerender:install": "bunx playwright install --with-deps chromium",
    "generate": "bun run process:static && bun run generate:sitemap && bun run prerender:install && bun run prerender"
  },
  "dependencies": {
    "@breezystack/lamejs": "~1.2.7",
    "@heroicons/react": "~2.2.0",
    "@radix-ui/react-alert-dialog": "~1.2.1",
    "@radix-ui/react-dialog": "~1.3.1",
    "@radix-ui/react-label": "~2.1.17",
    "@radix-ui/react-select": "~2.4.1",
    "@radix-ui/react-slot": "~1.5.0",
    "@radix-ui/react-switch": "~1.4.1",
    "@radix-ui/react-tabs": "~1.2.1",
    "@react-three/fiber": "~9.8.2",
    "@revenuecat/purchases-js": "~1.73.1",
    "@sudobility/auth-components": "^1.0.12",
    "@sudobility/auth_lib": "^0.0.121",
    "@sudobility/building_blocks": "^0.0.344",
    "@sudobility/components": "^5.3.47",
    "@sudobility/consumables_client": "^0.0.38",
    "@sudobility/consumables_pages": "^0.0.70",
    "@sudobility/design": "^1.1.66",
    "@sudobility/di": "^1.5.82",
    "@sudobility/di_web": "^0.1.265",
    "@sudobility/entity_client": "^0.0.57",
    "@sudobility/entity_pages": "^0.0.188",
    "@sudobility/music_client": "^0.4.100",
    "@sudobility/music_codecs": "^0.2.61",
    "@sudobility/music_drawing": "^0.0.71",
    "@sudobility/music_editing": "^0.0.60",
    "@sudobility/music_io": "^0.9.79",
    "@sudobility/music_lib": "^1.9.82",
    "@sudobility/music_player": "^0.1.79",
    "@sudobility/music_spatial": "^0.0.29",
    "@sudobility/music_spatial_core": "^0.0.26",
    "@sudobility/music_types": "^0.13.59",
    "@sudobility/seo_lib": "^0.0.49",
    "@sudobility/types": "^1.9.76",
    "@tanstack/react-query": "~5.104.5",
    "class-variance-authority": "~0.7.1",
    "clsx": "~2.1.1",
    "firebase": "~12.19.0",
    "i18next": "~26.3.1",
    "i18next-browser-languagedetector": "~8.2.1",
    "i18next-http-backend": "~4.0.4",
    "immer": "~11.2.9",
    "js-synthesizer": "~1.13.0",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-helmet-async": "~3.0.0",
    "react-i18next": "~17.0.8",
    "react-router-dom": "~7.18.4",
    "tailwind-merge": "~3.7.0",
    "three": "~0.186.1",
    "vexflow": "~4.2.5",
    "zod": "~4.6.5",
    "zustand": "~5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "~1.64.1",
    "@testing-library/dom": "~10.4.2",
    "@testing-library/jest-dom": "~7.0.1",
    "@testing-library/react": "~16.3.3",
    "@testing-library/user-event": "~14.6.8",
    "@types/node": "~26.6.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "~5.1.2",
    "@vitest/coverage-v8": "~4.1.12",
    "autoprefixer": "~10.6.1",
    "eslint": "~10.13.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-react-hooks": "~7.1.1",
    "eslint-plugin-react-refresh": "~0.4.26",
    "fake-indexeddb": "~6.2.6",
    "htmlparser2": "~12.0.0",
    "jsdom": "~30.1.3",
    "postcss": "~8.5.31",
    "prettier": "~3.9.10",
    "tailwindcss": "~3.4.19",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.72.0",
    "vite": "~7.3.7",
    "vitest": "~4.1.12",
    "playwright": "~1.64.1",
    "tsx": "~4.23.15"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/music_app.git"
  }
}
